# Copy to .env and fill in. Never share or commit the real .env.

# Turn DEBUG on only on your own computer.
DEBUG=False
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Your domain(s), comma separated
ALLOWED_HOSTS=littlemove.pk,www.littlemove.pk
CSRF_TRUSTED_ORIGINS=https://littlemove.pk,https://www.littlemove.pk

# Leave empty to use the built-in SQLite file (fine for a small shop).
# DATABASE_URL=postgres://user:password@localhost:5432/littlemove

# Admin panel address (keep it non-obvious)
ADMIN_URL=manage-store/

# Get an email for every new order (needs a Gmail App Password)
ORDER_ALERT_EMAIL=littlemoveofficial@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=littlemoveofficial@gmail.com
EMAIL_HOST_PASSWORD=

# Set false if your host serves /media/ itself (e.g. PythonAnywhere static files mapping)
SERVE_MEDIA=True
